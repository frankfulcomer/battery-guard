#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
TEST_DIR=$(mktemp -d)
trap 'rm -rf "$TEST_DIR"' EXIT

mkdir -p "$TEST_DIR/config" "$TEST_DIR/bin"

cat > "$TEST_DIR/bin/upower" <<'EOF'
#!/usr/bin/env bash
printf '  state:               %s\n' "${TEST_STATE}"
printf '  percentage:          %s%%\n' "${TEST_PERCENT}"
EOF

cat > "$TEST_DIR/bin/fake-poweroff" <<EOF
#!/usr/bin/env bash
touch "$TEST_DIR/powered-off"
EOF

cat > "$TEST_DIR/bin/fake-warning" <<EOF
#!/usr/bin/env bash
printf 'warning at %s%% (threshold %s%%)\n' "\$1" "\$2" >> "$TEST_DIR/warnings"
EOF

chmod +x "$TEST_DIR/bin/upower" "$TEST_DIR/bin/fake-poweroff" "$TEST_DIR/bin/fake-warning"
ln -s "$PROJECT_DIR/src/battery-guard" "$TEST_DIR/battery-guard"

run_guard() {
    local state=$1
    local percent=$2
    local dry_run=$3

    printf 'WARNING_THRESHOLD=30\nTHRESHOLD=20\nDRY_RUN=%s\nWARNING_USER=test-user\nHISTORY_ENABLED=true\nHISTORY_RETENTION_DAYS=90\n' \
        "$dry_run" > "$TEST_DIR/config/battery-guard.conf"
    rm -f "$TEST_DIR/powered-off"

    (
        cd "$TEST_DIR"
        PATH="$TEST_DIR/bin:$PATH" \
        TEST_STATE="$state" \
        TEST_PERCENT="$percent" \
        BATTERY_GUARD_POWEROFF_CMD="$TEST_DIR/bin/fake-poweroff" \
        BATTERY_GUARD_WARNING_CMD="$TEST_DIR/bin/fake-warning" \
        BATTERY_GUARD_WARNING_STATE_FILE="$TEST_DIR/warning-sent" \
        SYSTEM_GUARD_HISTORY_DIR="$TEST_DIR/history" \
        ./battery-guard
    )
}

rm -f "$TEST_DIR/warnings" "$TEST_DIR/warning-sent"

output=$(run_guard discharging 20 true)
grep -q 'DRY RUN: shutdown condition met.' <<< "$output"
[[ ! -e "$TEST_DIR/powered-off" ]]

output=$(run_guard charging 10 false)
grep -q 'Battery condition is safe.' <<< "$output"
[[ ! -e "$TEST_DIR/powered-off" ]]

output=$(run_guard discharging 20 false)
grep -q 'Shutdown condition met.' <<< "$output"
[[ -e "$TEST_DIR/powered-off" ]]

output=$(run_guard discharging 25 false)
grep -q 'Low battery warning condition met.' <<< "$output"
[[ $(wc -l < "$TEST_DIR/warnings") -eq 1 ]]

output=$(run_guard discharging 24 false)
grep -q 'Low battery warning was already sent' <<< "$output"
[[ $(wc -l < "$TEST_DIR/warnings") -eq 1 ]]

run_guard charging 24 false >/dev/null
output=$(run_guard discharging 25 false)
grep -q 'Low battery warning condition met.' <<< "$output"
[[ $(wc -l < "$TEST_DIR/warnings") -eq 2 ]]
grep -q 'discharging,25,warning' "$TEST_DIR/history/battery/"*.csv

printf 'All Low Battery Guard tests passed.\n'
