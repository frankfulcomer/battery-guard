#!/usr/bin/env bash

# Record one monotonic uptime sample. A systemd timer runs this every five minutes.
set -u

CONFIG="./config/uptime-guard.conf"
PROC_ROOT="${SYSTEM_GUARD_PROC_ROOT:-/proc}"
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
source "${SYSTEM_GUARD_HISTORY_LIB:-$SCRIPT_DIR/history-lib}"

fail() {
    echo "ERROR: $*"
    exit 1
}

[[ -r "$CONFIG" ]] || fail "Cannot read $CONFIG."
source "$CONFIG"
history_validate_config || exit 1

[[ -r "$PROC_ROOT/sys/kernel/random/boot_id" ]] || fail "Kernel boot ID is unavailable."
[[ -r "$PROC_ROOT/uptime" ]] || fail "Kernel uptime is unavailable."
BOOT_ID=$(<"$PROC_ROOT/sys/kernel/random/boot_id")
read -r UPTIME_RAW _ < "$PROC_ROOT/uptime"
[[ "$BOOT_ID" =~ ^[0-9a-fA-F-]+$ ]] || fail "Kernel boot ID is invalid."
[[ "$UPTIME_RAW" =~ ^[0-9]+([.][0-9]+)?$ ]] || fail "Kernel uptime is invalid."

# Whole seconds are sufficient for a five-minute trend sample.
UPTIME_SECONDS=${UPTIME_RAW%%.*}
EPOCH_SECONDS=$(date -u +%s)
history_append uptime 'epoch_seconds,boot_id,uptime_seconds' \
    "$EPOCH_SECONDS" "$BOOT_ID" "$UPTIME_SECONDS"

echo "Boot ID: $BOOT_ID"
echo "Uptime: $UPTIME_SECONDS seconds"
