#!/usr/bin/env bash

# Summarize recent structured history without requiring a database or plotting tool.
set -u

HISTORY_ROOT="${SYSTEM_GUARD_HISTORY_DIR:-/var/lib/system-guard/history}"
DAYS=${1:-7}
if ! [[ "$DAYS" =~ ^[0-9]+$ ]] || (( DAYS < 1 )); then
    echo "Usage: system-guard-report [positive-number-of-days]" >&2
    exit 1
fi

history_files() {
    local component=$1
    find "$HISTORY_ROOT/$component" -maxdepth 1 -type f -name '????-??-??.csv' \
        -mtime "-$DAYS" -print0 2>/dev/null | sort -z
}

print_battery() {
    local files=()
    mapfile -d '' files < <(history_files battery)
    echo "Battery (last $DAYS days)"
    if (( ${#files[@]} == 0 )); then
        echo "  No history available."
        return
    fi
    awk -F, '
        FNR == 1 {next}
        NR == 2 || $3 < min {min=$3}
        NR == 2 || $3 > max {max=$3}
        {count++; timestamp=$1; state=$2; percent=$3; status=$4}
        END {
            printf "  Samples: %d | Range: %d%%-%d%%\n", count, min, max
            printf "  Latest: %s, %s%%, %s (%s)\n", timestamp, percent, state, status
        }
    ' "${files[@]}"
}

print_thermal() {
    local files=()
    mapfile -d '' files < <(history_files thermal)
    echo "Thermal (last $DAYS days)"
    if (( ${#files[@]} == 0 )); then
        echo "  No history available."
        return
    fi
    awk -F, '
        FNR == 1 {next}
        count == 0 || $3 < min {min=$3}
        count == 0 || $3 > max {max=$3}
        {count++; timestamp=$1; zone=$2; temp=$3; status=$4}
        END {
            printf "  Samples: %d | Range: %.1f-%.1f C\n", count, min/1000, max/1000
            printf "  Latest: %s, %.1f C at %s (%s)\n", timestamp, temp/1000, zone, status
        }
    ' "${files[@]}"
}

print_storage() {
    local files=()
    mapfile -d '' files < <(history_files storage)
    echo "Storage (last $DAYS days)"
    if (( ${#files[@]} == 0 )); then
        echo "  No history available."
        return
    fi
    awk -F, '
        FNR == 1 {next}
        count == 0 || $3 < min {min=$3}
        count == 0 || $3 > max {max=$3}
        {
            count++; timestamp=$1; mount=$2; usage=$3; available=$4
            capacity=$5; device=$6; health=$7; temp=$8; wear=$9
        }
        END {
            printf "  Samples: %d | Usage range: %d%%-%d%%\n", count, min, max
            printf "  Latest: %s, %s%% used, %s KiB free (%s)\n", timestamp, usage, available, capacity
            printf "  Device: %s | Health: %s", device == "" ? "unavailable" : device, health
            if (temp != "") printf " | Temperature: %s C", temp
            if (wear != "") printf " | Life used: %s%%", wear
            printf "\n"
        }
    ' "${files[@]}"
}

print_uptime() {
    local files=()
    mapfile -d '' files < <(history_files uptime)
    echo "System uptime (last $DAYS days)"
    if (( ${#files[@]} == 0 )); then
        echo "  No history available."
        return
    fi

    local now_epoch current_boot current_uptime_raw current_uptime
    now_epoch=$(date -u +%s)
    current_boot=$(<"${SYSTEM_GUARD_PROC_ROOT:-/proc}/sys/kernel/random/boot_id")
    read -r current_uptime_raw _ < "${SYSTEM_GUARD_PROC_ROOT:-/proc}/uptime"
    current_uptime=${current_uptime_raw%%.*}

    awk -F, -v now="$now_epoch" -v live_boot="$current_boot" -v live_uptime="$current_uptime" '
        function duration(seconds, days, hours, minutes, result) {
            if (seconds < 0) seconds = 0
            days = int(seconds / 86400); seconds %= 86400
            hours = int(seconds / 3600); seconds %= 3600
            minutes = int(seconds / 60)
            result = ""
            if (days) result = result days "d "
            if (hours || days) result = result hours "h "
            return result minutes "m"
        }
        FNR == 1 {next}
        count == 0 {
            first_epoch=$2; previous_epoch=$2; previous_boot=$3; previous_uptime=$4
            count=1; next
        }
        {
            wall_delta=$2-previous_epoch
            if ($3 == previous_boot && $4 >= previous_uptime) {
                online += $4-previous_uptime
            } else if ($3 != previous_boot) {
                contribution=$4
                if (contribution > wall_delta) contribution=wall_delta
                online += contribution
                reboots++
            }
            previous_epoch=$2; previous_boot=$3; previous_uptime=$4; count++
        }
        END {
            if (live_boot == previous_boot && live_uptime >= previous_uptime) {
                online += live_uptime-previous_uptime
                end_epoch=now
            } else {
                end_epoch=previous_epoch
            }
            observed=end_epoch-first_epoch
            if (online > observed) online=observed
            offline=observed-online
            availability=observed > 0 ? online*100/observed : 100
            printf "  Observed: %s | Samples: %d\n", duration(observed), count
            printf "  Online: %s | Offline: %s | Availability: %.1f%%\n", duration(online), duration(offline), availability
            printf "  Reboots observed: %d | Current uptime: %s\n", reboots, duration(live_uptime)
        }
    ' "${files[@]}"
}

echo "System Guard trend report"
echo
print_battery
echo
print_thermal
echo
print_storage
echo
print_uptime
