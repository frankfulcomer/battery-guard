#!/usr/bin/env bash

CONFIG="./config/battery-guard.conf"
BATTERY="/org/freedesktop/UPower/devices/battery_BAT1"

source "$CONFIG"

if ! [[ "$THRESHOLD" =~ ^[0-9]+$ ]]; then
    echo "ERROR: THRESHOLD must be a whole number."
    exit 1
fi

if (( THRESHOLD < 1 || THRESHOLD > 100 )); then
    echo "ERROR: THRESHOLD must be between 1 and 100."
    exit 1
fi

if [[ "$DRY_RUN" != "true" && "$DRY_RUN" != "false" ]]; then
    echo "ERROR: DRY_RUN must be either true or false."
    exit 1
fi

INFO=$(upower -i "$BATTERY")

if [[ -z "$INFO" ]]; then
    echo "ERROR: Unable to read battery information from UPower."
    exit 1
fi

STATE=$(printf '%s\n' "$INFO" | awk -F': +' '/state:/ {print $2}')
PERCENT=$(printf '%s\n' "$INFO" | awk -F': +' '/percentage:/ {gsub("%","",$2); print $2}')

if [[ -z "$STATE" ]]; then
    echo "ERROR: Battery state is missing."
    exit 1
fi

if ! [[ "$PERCENT" =~ ^[0-9]+$ ]]; then
    echo "ERROR: Battery percentage is invalid: '$PERCENT'"
    exit 1
fi

if (( PERCENT < 0 || PERCENT > 100 )); then
    echo "ERROR: Battery percentage is outside the valid range: $PERCENT%"
    exit 1
fi

echo "State: $STATE"
echo "Percentage: $PERCENT%"

if [[ "$STATE" == "discharging" && "$PERCENT" -le "$THRESHOLD" ]]; then
    if [[ "$DRY_RUN" == "true" ]]; then
        echo "DRY RUN: shutdown condition met."
    else
        echo "Shutdown condition met."
        echo "System would power off here."
    fi
else
    echo "Battery condition is safe."
fi