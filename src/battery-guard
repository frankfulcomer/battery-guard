#!/usr/bin/env bash

# This script performs one battery check and then exits. It does not contain its
# own loop. The systemd timer is responsible for starting the script again at
# regular intervals.

# CONFIG is the small settings file that contains the shutdown percentage and
# the dry-run switch. The systemd service sets its working directory to the
# repository root, which is why this relative path works both manually and when
# systemd starts the script.
CONFIG="./config/battery-guard.conf"

# UPower identifies each power device with an object path. On this computer the
# main battery is BAT1. Running `upower -e` lists the available object paths if
# this value ever needs to be changed for a different computer.
BATTERY="/org/freedesktop/UPower/devices/battery_BAT1"

# In normal operation, systemctl is the program used to power off the computer.
# The optional environment variable exists so the automated test can substitute
# a harmless fake command. The production systemd unit does not set that
# variable, so normal live operation always uses /usr/bin/systemctl.
POWEROFF_CMD="${BATTERY_GUARD_POWEROFF_CMD:-/usr/bin/systemctl}"

power_off() {
    # During an automated test, run only the supplied fake command. It accepts
    # no arguments and merely records that Battery Guard reached this point.
    if [[ -n "${BATTERY_GUARD_POWEROFF_CMD:-}" ]]; then
        "$POWEROFF_CMD"
    else
        # This is the real shutdown action. It is reached only when the battery
        # is discharging, its percentage is at or below the threshold, and
        # DRY_RUN has explicitly been set to false.
        "$POWEROFF_CMD" poweroff
    fi
}

# Load THRESHOLD and DRY_RUN from the configuration file into this script.
# Because the file is executable shell syntax, it should contain only trusted
# configuration assignments such as THRESHOLD=20 and DRY_RUN=true.
source "$CONFIG"

# Reject missing values, decimals, negative signs, and other non-numeric text.
# The later arithmetic comparisons are safe only after this format check.
if ! [[ "$THRESHOLD" =~ ^[0-9]+$ ]]; then
    echo "ERROR: THRESHOLD must be a whole number."
    exit 1
fi

# A percentage outside 1 through 100 would be a configuration mistake. Zero is
# intentionally rejected so a bad reading cannot create an impractical setting.
if (( THRESHOLD < 1 || THRESHOLD > 100 )); then
    echo "ERROR: THRESHOLD must be between 1 and 100."
    exit 1
fi

# Require an exact true or false value. This prevents a typo such as "ture" from
# being interpreted as live mode or otherwise producing ambiguous behavior.
if [[ "$DRY_RUN" != "true" && "$DRY_RUN" != "false" ]]; then
    echo "ERROR: DRY_RUN must be either true or false."
    exit 1
fi

# Ask UPower for the complete information record for the selected battery. The
# record includes many fields; Battery Guard extracts only state and percentage.
INFO=$(upower -i "$BATTERY")

# Empty output means Battery Guard has no trustworthy information on which to
# base a shutdown decision, so it stops with an error instead of guessing.
if [[ -z "$INFO" ]]; then
    echo "ERROR: Unable to read battery information from UPower."
    exit 1
fi

# UPower prints labeled lines such as "state: discharging" and
# "percentage: 19%". These two commands keep the value after the colon and
# remove the percent sign so Bash can compare the percentage as a number.
STATE=$(printf '%s\n' "$INFO" | awk -F': +' '/state:/ {print $2}')
PERCENT=$(printf '%s\n' "$INFO" | awk -F': +' '/percentage:/ {gsub("%","",$2); print $2}')

# A missing state is treated as an error. Without it, Battery Guard cannot tell
# whether the computer is using the battery or receiving external power.
if [[ -z "$STATE" ]]; then
    echo "ERROR: Battery state is missing."
    exit 1
fi

# Validate the UPower percentage before performing arithmetic. Refusing invalid
# telemetry is safer than treating malformed or missing data as a low battery.
if ! [[ "$PERCENT" =~ ^[0-9]+$ ]]; then
    echo "ERROR: Battery percentage is invalid: '$PERCENT'"
    exit 1
fi

# UPower should report a value from 0 through 100. Anything else indicates bad
# telemetry, so Battery Guard reports the problem and takes no shutdown action.
if (( PERCENT < 0 || PERCENT > 100 )); then
    echo "ERROR: Battery percentage is outside the valid range: $PERCENT%"
    exit 1
fi

# Print every accepted reading. When systemd starts the script, these messages
# are saved in the journal and provide a simple operating history.
echo "State: $STATE"
echo "Percentage: $PERCENT%"

# Both conditions must be true before shutdown is considered:
#   1. The battery must actually be discharging.
#   2. Its percentage must be at or below the configured threshold.
# A low percentage while charging, fully charged, or pending charge is safe and
# deliberately does not trigger a shutdown.
if [[ "$STATE" == "discharging" && "$PERCENT" -le "$THRESHOLD" ]]; then
    # Dry-run mode follows the full decision path but stops before the power-off
    # function. This makes it safe to validate configuration and telemetry.
    if [[ "$DRY_RUN" == "true" ]]; then
        echo "DRY RUN: shutdown condition met."
    else
        # Live mode has met every required condition, so record the decision and
        # ask systemd to power off the computer cleanly.
        echo "Shutdown condition met."
        power_off
    fi
else
    # This message covers every case in which no protective action is required.
    echo "Battery condition is safe."
fi
