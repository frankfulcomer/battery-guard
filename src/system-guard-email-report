#!/usr/bin/env bash

# Send at most one trend report per ISO week at the configured local day/hour.
set -u

CONFIG="${SYSTEM_GUARD_EMAIL_CONFIG:-/etc/system-guard/email-report.conf}"
DATE_CMD="${SYSTEM_GUARD_DATE_CMD:-/usr/bin/date}"
REPORT_CMD="${SYSTEM_GUARD_REPORT_CMD:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/system-guard-report}"
MAIL_CMD="${SYSTEM_GUARD_MAIL_CMD:-/usr/bin/msmtp}"
SENT_STATE_FILE="${SYSTEM_GUARD_EMAIL_STATE_FILE:-/var/lib/system-guard/email-last-sent}"

fail() {
    echo "ERROR: $*"
    exit 1
}

[[ -r "$CONFIG" ]] || fail "Cannot read email configuration at $CONFIG."
source "$CONFIG"

[[ "${EMAIL_ENABLED:-}" == true || "${EMAIL_ENABLED:-}" == false ]] || \
    fail "EMAIL_ENABLED must be either true or false."
[[ "$EMAIL_ENABLED" == true ]] || {
    echo "Weekly email reporting is disabled."
    exit 0
}
for setting in EMAIL_TO EMAIL_FROM EMAIL_SUBJECT SMTP_ACCOUNT; do
    [[ -n "${!setting:-}" ]] || fail "$setting must not be empty."
    [[ "${!setting}" != *$'\n'* && "${!setting}" != *$'\r'* ]] || \
        fail "$setting contains an invalid line break."
done
[[ "$EMAIL_TO" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || \
    fail "EMAIL_TO is not a valid email address."
[[ "$EMAIL_FROM" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || \
    fail "EMAIL_FROM is not a valid email address."
case "${REPORT_DAY:-}" in
    Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday) ;;
    *) fail "REPORT_DAY must be a full English weekday name." ;;
esac
[[ "${REPORT_HOUR:-}" =~ ^([0-9]|1[0-9]|2[0-3])$ ]] || \
    fail "REPORT_HOUR must be a whole number from 0 through 23."
[[ "${REPORT_DAYS:-}" =~ ^[0-9]+$ ]] && (( REPORT_DAYS >= 1 )) || \
    fail "REPORT_DAYS must be a positive whole number."
[[ -x "$REPORT_CMD" ]] || fail "Report command is not executable: $REPORT_CMD."
[[ -x "$MAIL_CMD" ]] || fail "Mail command is not executable: $MAIL_CMD."

CURRENT_DAY=$($DATE_CMD +%A)
CURRENT_HOUR=$((10#$($DATE_CMD +%H)))
CURRENT_WEEK=$($DATE_CMD +%G-W%V)
if [[ "${SYSTEM_GUARD_REPORT_FORCE:-false}" != true ]] && \
    { [[ "$CURRENT_DAY" != "$REPORT_DAY" ]] || (( CURRENT_HOUR != REPORT_HOUR )); }; then
    echo "Weekly report is not due ($REPORT_DAY at $(printf '%02d:00' "$REPORT_HOUR"))."
    exit 0
fi

LAST_SENT=""
[[ -r "$SENT_STATE_FILE" ]] && LAST_SENT=$(<"$SENT_STATE_FILE")
if [[ "$LAST_SENT" == "$CURRENT_WEEK" ]]; then
    echo "Weekly report was already sent for $CURRENT_WEEK."
    exit 0
fi

REPORT_OUTPUT=$($REPORT_CMD "$REPORT_DAYS") || fail "Unable to generate the trend report."
MESSAGE=$(printf 'From: %s\nTo: %s\nSubject: %s\nContent-Type: text/plain; charset=UTF-8\n\n%s\n' \
    "$EMAIL_FROM" "$EMAIL_TO" "$EMAIL_SUBJECT" "$REPORT_OUTPUT")

if ! printf '%s' "$MESSAGE" | "$MAIL_CMD" --account="$SMTP_ACCOUNT" "$EMAIL_TO"; then
    fail "Unable to send the weekly report."
fi

mkdir -p "$(dirname "$SENT_STATE_FILE")" || fail "Unable to create the email state directory."
printf '%s\n' "$CURRENT_WEEK" > "$SENT_STATE_FILE" || \
    fail "Unable to record weekly email delivery."
echo "Weekly System Guard report sent to $EMAIL_TO for $CURRENT_WEEK."
